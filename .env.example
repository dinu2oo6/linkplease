# Your PseudoGram key. Doubles as the HMAC secret for inbound webhook signatures.
# Put the real value in .env (gitignored), never here -- this file is committed.
PSEUDOGRAM_API_KEY=

# The email you applied with (used by scripts/apply_and_keygen.py and /v1/submit).
PSEUDOGRAM_EMAIL=you@example.com

PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Where the ledger lives. On Fly this is the mounted volume.
DB_PATH=./data/linkplease.db

# Our own public webhook URL, so /admin/simulate can point PseudoGram at us.
PUBLIC_WEBHOOK_URL=https://your-app.fly.dev/webhook

# Set false ONLY for local runs against scripts/chaos_server.py without a key.
REQUIRE_SIGNATURE=true
